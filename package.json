{
  "name": "@lzwme/m3u8-dl",
  "version": "1.10.0",
  "description": "Lightweight M3U8 batch downloader with resumable downloads, mobile WebUI and lossless merging.",
  "main": "cjs/index.js",
  "types": "cjs/index.d.ts",
  "license": "MIT",
  "homepage": "https://m3u8-downloader.lzw.me/portal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzwme/m3u8-dl.git"
  },
  "author": {
    "name": "renxia",
    "email": "lzwy0820@qq.com",
    "url": "https://lzw.me"
  },
  "scripts": {
    "dev": "concurrently \"pnpm dev:sdk\" \"pnpm dev:server\" \"pnpm dev:frontend\"",
    "dev:sdk": "tsc -p tsconfig.cjs.json --watch",
    "dev:server": "node --watch cjs/server/index.js",
    "dev:frontend": "pnpm -F @lzwme/m3u8-dl-frontend dev",
    "start": "node cjs/server/index.js",
    "build": "pnpm clean && pnpm build:cjs && pnpm build:frontend",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:frontend": "pnpm -F @lzwme/m3u8-dl-frontend build",
    "clean": "node scripts/clean.cjs",
    "lint": "biome lint",
    "lint:all": "pnpm lint && pnpm -F @lzwme/m3u8-dl-frontend lint",
    "test": "pnpm build:cjs && node --test test/*.test.cjs",
    "typecheck": "pnpm build:cjs && pnpm -F @lzwme/m3u8-dl-frontend typecheck"
  },
  "bin": {
    "m3u8dl": "bin/m3u8dl.js"
  },
  "keywords": [
    "m3u8-download",
    "m3u8",
    "mp4",
    "download",
    "ffmpeg"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.com"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/express": "^5.0.6",
    "@types/global-agent": "^3.0.0",
    "@types/m3u8-parser": "^7.2.6",
    "@types/node": "^26.4.1",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "typescript": "^6"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "global-agent": "^4.1.3",
    "m3u8-parser": "^7.2.0",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  },
  "files": [
    "cjs",
    "client/index.html",
    "client/assets",
    "bin",
    "src/types/contract.ts"
  ]
}
